# Include this location block in the existing HTTPS virtual host for
# fvls.mywavewake.ru after the FVLS Moscow container is healthy.
#
# The existing TLS certificate and security headers stay on the host proxy.
# Change 8080 only if FVLS_PORT was changed in .env.
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
